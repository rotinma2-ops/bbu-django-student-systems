# ==============================================================================
# Environment Configuration Template for Django Student Management System
# Build Bright University (BBU) - Python Project
# Instructions: Copy this file to .env and adjust the values for your environment.
#   Command: cp .env.example .env
# ==============================================================================

# Django Core Settings
# In Production (Vercel): DEBUG defaults to False. Set SECRET_KEY in Vercel > Settings > Environment Variables.
DEBUG=False

# SECURITY WARNING: Use a strong, random secret key in production!
SECRET_KEY=django-insecure-replace-this-with-a-very-long-random-secret-key-in-production

# Allowed Hosts (Comma-separated hostnames/IPs)
# *.vercel.app is always allowed automatically. Add your custom domain here if you have one.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,.vercel.app

# CSRF Trusted Origins (Comma-separated HTTPS origins for Django 4.0+)
# Example: https://my-bbu-app.vercel.app,https://www.my-domain.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.vercel.app

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# 1. Local Development (SQLite - default)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# 2. Production Database on Vercel (Neon / Supabase Postgres)
#    Vercel sets DATABASE_URL for you when you add a Postgres database from Storage/Marketplace.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
#
#    Set AUTO_SETUP=True ONCE on Vercel to create tables + demo accounts/data in a fresh
#    database on the next cold start, then remove it.
# AUTO_SETUP=False

# 3. Manual PostgreSQL Configuration (Alternative)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=bbu_student_db
# DB_USER=postgres
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432

# ------------------------------------------------------------------------------
# Production Security Settings (Enable when SSL/HTTPS is active in Production)
# ------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ------------------------------------------------------------------------------
# Internationalization & Localization
# ------------------------------------------------------------------------------
LANGUAGE_CODE=km
TIME_ZONE=Asia/Phnom_Penh
USE_I18N=True
USE_TZ=True

# Static and Media URLs
STATIC_URL=/static/
MEDIA_URL=/media/
